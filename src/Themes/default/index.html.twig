{% extends 'base.html.twig' %}

{% block title %}HCNOTES — Yevhen Matasar, software engineer{% endblock %}
{% block head_extra %}
    {# Same pattern as article.html.twig: built as data, encoded once with
       JSON_HEX_TAG, so no value can close the script element. #}
    {% set website = {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        'name': 'HCNOTES',
        'url': site_base_url ~ '/',
        'description': block('description'),
        'author': {'@type': 'Person', 'name': 'Yevhen Matasar', 'url': site_base_url ~ '/about'},
    } %}
    <script type="application/ld+json">{{ website|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block content %}
<section class="hero">
    <div class="terminal">
        <div class="terminal__bar">
            <span class="dot dot--gl"></span>
            <span class="dot dot--a2"></span>
            <span class="dot dot--gr"></span>
            <span class="path">~/hcnotes — ssh</span>
        </div>
        <div class="terminal__body">
            <p class="line"><span class="prompt"></span><span class="cmd">whoami</span></p>
            <h1 class="role out">
                <b>software engineer</b> <span class="sep">·</span>
                <b>gamer</b> <span class="sep">·</span>
                <b>father</b>
            </h1>

            <p class="intro">A personal blog — notes on software development, AI-first tooling, and the things I build on the side. <a href="/about">More about me</a>.</p>

            <p class="line contact"><span class="prompt"></span><span class="cmd">contact --reveal</span></p>
            <p class="out">
                ‹<a href="#" class="reveal" id="field_email">email</a>›<span class="caret"></span>
            </p>
        </div>
    </div>

    {% if articles is defined and articles is not empty %}
    <div class="notes">
        <div class="notes__h">transmissions</div>
        <ul>
            {% for article in articles %}
            <li>
                <a href="/article/{{ article.slug }}">{{ article.title }}</a>
                <small>
                    {{ article.date }}
                    {% for tag in article.tagsArray %}<span class="tag">{{ tag }}</span>{% endfor %}
                </small>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <p class="credit">
        Background: a generative reimagining of <span class="k-accent">Aleph&nbsp;2</span> —
        <a href="https://web.archive.org/web/20230606143351/https://mkweb.bcgsc.ca/infinity/math.of.infinity.mhtml" target="_blank" rel="noopener">Martin Krzywinski</a>
        &amp; <a href="https://www.youtube.com/watch?v=tNYfqklRehM" target="_blank" rel="noopener">Max Cooper</a>.
        Counting to <span class="k-accent2">infinity</span>, one glitch at a time.
    </p>
</section>
{% endblock %}

{% block scripts %}
<script>
    (function () {
        var el = document.getElementById('field_email');
        if (!el) return;
        el.addEventListener('click', function (e) {
            e.preventDefault();
            var email = atob('bWF0YXNhci5laUBnbWFpbC5jb20=');
            el.textContent = email;
            el.setAttribute('href', 'mailto:' + email);
        });
    })();
</script>
{% endblock %}

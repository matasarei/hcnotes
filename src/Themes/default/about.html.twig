{% extends 'base.html.twig' %}

{% block title %}Yevhen Matasar — Software Engineer — HCNOTES{% endblock %}
{% block description %}Yevhen Matasar — software engineer from Kyiv, Ukraine, 10+ years in PHP, Go and the cloud. Writing about AI agents and AI-first development.{% endblock %}
{% block og_type %}profile{% endblock %}
{% block og_image %}https://github.com/matasarei.png?size=400{% endblock %}
{% block twitter_card %}summary{% endblock %}
{% block og_image_meta %}{% endblock %}
{% block head_extra %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Yevhen Matasar",
        "url": "{{ site_base_url }}/about",
        "image": "https://github.com/matasarei.png?size=400",
        "jobTitle": "Software Engineer",
        "description": "Software engineer from Kyiv, Ukraine, writing about AI agents and AI-first development.",
        "sameAs": [
            "https://github.com/matasarei"
        ]
    }
    </script>
{% endblock %}

{% block content %}
<section class="about">
    <div class="terminal">
        <div class="terminal__bar">
            <span class="dot dot--gl"></span>
            <span class="dot dot--a2"></span>
            <span class="dot dot--gr"></span>
            <span class="path">~/hcnotes/about</span>
        </div>
        <div class="terminal__body">
            <p class="line"><span class="prompt"></span><span class="cmd">cat ./about.md</span></p>
            <div class="about__head">
                <div class="avatar">
                    <img src="https://github.com/matasarei.png?size=200" alt="Yevhen Matasar" width="200" height="200" loading="lazy"
                         onload="this.parentNode.classList.add('is-loaded')"
                         onerror="this.parentNode.classList.add('is-error')">
                </div>
                <div class="about__headtext">
                    <h1 class="about__name glitch" data-text="YEVHEN MATASAR">Yevhen Matasar</h1>
                    <p class="about__handle">@matasarei <span class="sep">·</span> 🇧🇬 Varna, Bulgaria</p>
                </div>
            </div>
            <div class="about__bio">
                <p>
                    A software engineer originally from Kyiv, Ukraine&nbsp;🇺🇦. Graduated in 2014 from the
                    <a href="https://partner.kubg.edu.ua/" target="_blank" rel="noopener">IT department</a>&nbsp;💻,
                    I have more than 10 years of experience in software development, worked for several
                    companies and on multiple projects, mostly on the backend.
                </p>
                <p>
                    These days I work as a Tech Lead: less typing, more architecture, reviews, and
                    helping a team ship. Most of what I write here is about doing that with AI agents
                    in the loop.
                </p>
                <p>
                    My dream is a healthy and open planet Earth&nbsp;🌎, with no wars and borders.
                    Sadly, the current situation
                    <a href="https://www.americanbanker.com/payments/news/you-can-hear-the-bombs-a-fintech-developers-life-in-ukraine" target="_blank" rel="noopener">is worsening</a>&nbsp;🔥.
                    I still think better times are ahead&nbsp;🍀
                    (<a href="/article/articles-better-times-are-ahead-bring-boots">How?</a>).
                </p>
            </div>
            <div class="links-row">
                <a class="btn-link" href="/">› Read the articles</a>
            </div>
        </div>
    </div>

    {#
        Experience as stacks: every stack is backed by public repositories where the
        work can be checked. A badge with no repository behind it does not belong here.
    #}
    {% set stacks = [
        {
            modifier: 'ai',
            title: 'AI engineering',
            lead: 'What I build around coding agents: the harness, the tooling, the local workbench.',
            badges: [
                {name: 'Agent skills', class: 'b-skills'},
                {name: 'MCP', class: 'b-mcp'},
                {name: 'Local LLMs', class: 'b-llm'},
                {name: 'Python', class: 'b-python'},
                {name: 'Kotlin', class: 'b-kotlin'},
                {name: 'TypeScript', class: 'b-ts'},
            ],
            repos: [
                {repo: 'matasarei/lectern', desc: 'Local modular AI workbench: chat and OCR on your own hardware'},
                {repo: 'matasarei/pi-dev-skills', desc: 'Development harness for Pi Coding Agent, tuned for local ~30B models'},
                {repo: 'matasarei/quest-hud', desc: 'Claude Code mod that draws the session as a small game HUD'},
                {repo: 'grinchenkoedu/claude-skills', desc: 'Chained Claude Code skills: plan, implement, review, verify'},
                {repo: 'matasarei/antigravity-companion', desc: 'JetBrains plugin that gives the Antigravity CLI the IDE context over MCP'},
                {repo: 'grinchenkoedu/antigravity-skills', desc: 'The same development workflow for Google Antigravity'},
            ],
            note: 'Not public: building a team harness and a custom development environment.',
        },
        {
            title: 'Native apps',
            badges: [
                {name: 'Swift', class: 'b-swift'},
                {name: 'Kotlin', class: 'b-kotlin'},
                {name: 'Rust', class: 'b-rust'},
            ],
            repos: [
                {repo: 'matasarei/hcboard', desc: 'Private Android keyboard with zero network access'},
                {repo: 'matasarei/tunnelhop', desc: 'VPN server rotation for Windows, with a kill-switch'},
                {repo: 'matasarei/wow-launcher', desc: 'Native macOS launcher for classic WoW on Apple Silicon (Wine, DXVK, Metal)'},
                {repo: 'matasarei/mac-bottler', desc: 'Builds a self-contained macOS app for a Windows game from a small recipe'},
            ],
        },
        {
            title: 'Web platforms & APIs',
            badges: [
                {name: 'PHP', class: 'b-php'},
                {name: 'Symfony', class: 'b-symfony'},
                {name: 'SQL', class: 'b-sql'},
                {name: 'GraphQL', class: 'b-graphql'},
                {name: 'Moodle', class: 'b-moodle'},
                {name: 'Docker', class: 'b-docker'},
            ],
            repos: [
                {repo: 'matasarei/aicmf', desc: 'AI-first flat-file CMF: Markdown, SQLite, hybrid semantic search. This site is built on it'},
                {repo: 'grinchenkoedu/local_cleanup', desc: 'Moodle admin plugin that reclaims disk space'},
                {repo: 'matasarei/json-rpc', desc: 'JSON-RPC client and server for PHP'},
                {repo: 'grinchenkoedu/diia-php', desc: 'Client for the Diia acquirer API: document signing and sharing'},
            ],
            note: 'Not public: university systems on Moodle and Symfony, and a CRM on a GraphQL API.',
        },
        {
            title: 'Browser & graphics',
            badges: [
                {name: 'React', class: 'b-react'},
                {name: 'Next.js', class: 'b-next'},
                {name: 'JavaScript', class: 'b-js'},
                {name: 'three.js', class: 'b-three'},
                {name: 'PixiJS', class: 'b-pixi'},
                {name: 'Canvas', class: 'badge--w'},
            ],
            repos: [
                {repo: 'matasarei/tryonface', desc: 'Virtual glasses try-on with real-time webcam face tracking'},
                {repo: 'matasarei/space-city', desc: 'Classic SimCity-like Mars colony city-builder in the browser'},
                {repo: 'matasarei/hcnotes', href: 'https://github.com/matasarei/hcnotes/blob/main/public/assets/js/aleph.js', desc: 'aleph.js: the generative canvas background behind this page'},
            ],
            note: 'Not public: the CRM front end, on Next.js and React.',
        },
    ] %}
    {# Work with no public repository: listed apart, with no links that would look like proof. #}
    {% set earlier = [
        {
            title: 'Server applications',
            badges: [
                {name: 'Go', class: 'b-go'},
                {name: 'Node.js', class: 'b-node'},
                {name: 'C#', class: 'b-cs'},
                {name: 'Java', class: 'b-java'},
                {name: 'MongoDB', class: 'b-mongo'},
                {name: 'DynamoDB', class: 'b-dynamo'},
            ],
            note: 'Work projects, not public.',
        },
        {
            title: 'Embedded systems',
            badges: [
                {name: 'C', class: 'b-c'},
                {name: 'C++', class: 'b-cpp'},
                {name: 'ESP32', class: 'b-esp'},
            ],
            note: 'Work projects, not public.',
        },
    ] %}

    <div class="section">
        <div class="section__h">stacks</div>
        <div class="stacks">
            {% for stack in stacks %}
            <article class="stack{{ stack.modifier is defined ? ' stack--' ~ stack.modifier }}">
                <h2 class="stack__title">{{ stack.title }}</h2>
                {% if stack.lead is defined %}<p class="stack__lead">{{ stack.lead }}</p>{% endif %}
                <div class="stack__badges">
                    {% for badge in stack.badges %}<span class="badge {{ badge.class }}">{{ badge.name }}</span>{% endfor %}
                </div>
                <ul class="stack__repos" role="list">
                    {% for item in stack.repos %}
                    <li>
                        <a href="{{ item.href ?? ('https://github.com/' ~ item.repo) }}" target="_blank" rel="noopener">{{ item.repo }}</a>
                        <span class="stack__desc">{{ item.desc }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% if stack.note is defined %}<p class="stack__note">{{ stack.note }}</p>{% endif %}
            </article>
            {% endfor %}
        </div>
        <div class="section__h section__h--sub">earlier work, not public</div>
        <div class="stacks stacks--earlier">
            {% for stack in earlier %}
            <article class="stack stack--earlier">
                <h2 class="stack__title">{{ stack.title }}</h2>
                <div class="stack__badges">
                    {% for badge in stack.badges %}<span class="badge {{ badge.class }}">{{ badge.name }}</span>{% endfor %}
                </div>
                <p class="stack__note">{{ stack.note }}</p>
            </article>
            {% endfor %}
        </div>
        <div class="links-row">
            <a class="btn-link" href="https://github.com/matasarei" target="_blank" rel="me noopener">› See more on GitHub</a>
        </div>
    </div>

    <div class="section">
        <div class="section__h">favorite games</div>
        <div class="cards">
            <div class="card card--game">
                <img src="/shared/img/wow.jpg" alt="World of Warcraft" loading="lazy">
                <div class="card__overlay">
                    <div class="card__top"><span class="game__tag">Since 2005</span></div>
                    <div class="card__title">World of Warcraft</div>
                </div>
            </div>
            <div class="card card--game">
                <img src="/shared/img/zelda.jpg" alt="The Legend of Zelda" loading="lazy">
                <div class="card__overlay">
                    <div class="card__top"><span class="game__tag game__tag--alt">Must play</span></div>
                    <div class="card__title">The Legend of Zelda</div>
                </div>
            </div>
            <div class="card card--game">
                <img src="/shared/img/horizon.jpg" alt="Horizon" loading="lazy">
                <div class="card__overlay">
                    <div class="card__top"></div>
                    <div class="card__title">Horizon</div>
                </div>
            </div>
            <div class="card card--game">
                <img src="/shared/img/watch_dogs.jpg" alt="Watch_Dogs" loading="lazy">
                <div class="card__overlay">
                    <div class="card__top"></div>
                    <div class="card__title">Watch_Dogs</div>
                </div>
            </div>
        </div>
        <div class="links-row">
            <a class="btn-link" href="https://steamcommunity.com/id/matasarei/games/?tab=all&amp;sort=playtime" target="_blank" rel="noopener">› Steam</a>
            <a class="btn-link" href="https://raider.io/characters/eu/ravencrest/Magazar" target="_blank" rel="noopener">› Raider.IO</a>
        </div>
        <p class="section-note">
            Game cover art is the property of the respective publishers
            (Blizzard, Nintendo, Sony, Ubisoft) and is shown here for illustration only.
        </p>
    </div>

    <p class="about__footer">
        Powered by 🤖 <a href="https://github.com/matasarei/aicmf" target="_blank" rel="noopener">AICMF</a>
    </p>
</section>
{% endblock %}
